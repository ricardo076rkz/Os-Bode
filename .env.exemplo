# Copie este arquivo para ".env" (na raiz do projeto). O ".env" NÃO vai para o GitHub.
# O mapa usa OpenStreetMap: não precisa de chave de API.

# Texto longo e aleatório para assinar o login. Se ficar em branco, o servidor cria um sozinho.
SECRET_KEY=

# Porta do servidor (opcional)
PORT=5000

# Modo de teste (qualquer usuário e senha entram). 1 = ligado (padrão nesta branch), 0 = desligado.
MODO_TESTE=1
