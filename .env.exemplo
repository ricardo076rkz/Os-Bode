# Copie este arquivo para ".env" (na raiz do projeto). O ".env" NÃO vai para o GitHub.
# O mapa usa OpenStreetMap: não precisa de chave de API.

# Texto longo e aleatório para assinar o login. Se ficar em branco, o servidor cria um sozinho.
SECRET_KEY=

# Porta do servidor (opcional)
PORT=5000

# Envio de e-mail (recuperar senha). Sem isto, o link aparece no terminal do servidor.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Endereço público do site (usado no link do e-mail)
# APP_URL=http://localhost:5000

# Coloque 1 só quando o site estiver em HTTPS
# COOKIE_SEGURO=1
