# Copie este arquivo para ".env" (na raiz do projeto) e preencha. O ".env" NÃO vai para o GitHub.

# Chave do Google Maps (Google Cloud Console -> APIs e serviços -> Credenciais).
# Ative: "Maps JavaScript API" e "Geocoding API". Restrinja a chave por site (http://localhost:5000/*).
GOOGLE_MAPS_API_KEY=

# Texto longo e aleatório para assinar o login. Se ficar em branco, o servidor cria um sozinho.
SECRET_KEY=

# Porta do servidor (opcional)
PORT=5000
